<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension
            point="org.eclipse.debug.core.launchConfigurationTypes">
        <launchConfigurationType
                name="BC-System Simulation"
                delegate="org.palladiosimulator.blockchainsystems.plugin.PluginLaunch"
                modes="run, debug"
                id="org.palladiosimulator.blockchainsystems.plugin.PluginLaunchConfigurationType">
        </launchConfigurationType>
    </extension>

    <extension
            point="org.eclipse.debug.ui.launchConfigurationTabGroups">
        <launchConfigurationTabGroup
                class="org.palladiosimulator.blockchainsystems.plugin.tabs.BlockchainSystemSimulatorTabGroup"
                id="org.palladiosimulator.blockchainsystems.plugin.ConfigurationTabGroups"
                type="org.palladiosimulator.blockchainsystems.plugin.PluginLaunchConfigurationType">
        </launchConfigurationTabGroup>
    </extension>

    <extension
            point="org.eclipse.debug.ui.launchConfigurationTypeImages">
        <launchConfigurationTypeImage
                id="org.palladiosimulator.blockchainsystems.plugin.ConfigurationTabGroupsImage"
                configTypeID="org.palladiosimulator.blockchainsystems.plugin.PluginLaunchConfigurationType"
                icon="icons/block.png">
        </launchConfigurationTypeImage>
    </extension>

    <extension
            point="org.eclipse.ui.views">
        <view
                name="Simulation Results Explorer"
                class="org.palladiosimulator.blockchainsystems.plugin.results.ui.SimulationResultsExplorer"
                id="org.palladiosimulator.blockchainsystems.SimulationResultsExplorer">
        </view>
    </extension>
</plugin>
